{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["~/.config/opencode/docs/index.md"],
  "default_agent": "plan",
  "formatter": {
    "prettier": {
      "command": ["npx", "prettier", "--write", "$FILE"],
      "extensions": [".ts", ".js", ".json", ".md", ".yaml", ".yml", ".html"]
    },
    "uv": {
      "command": ["uv", "run", "ruff", "format", "$FILE"],
      "extensions": [".py", ".pyi"]
    }
  },
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": "*.secret", "effect": "deny" },
    { "action": "read", "resource": "*credentials*", "effect": "deny" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.pem", "effect": "deny" },
    { "action": "edit", "resource": "*.key", "effect": "deny" },
    { "action": "edit", "resource": "*.secret", "effect": "deny" },
    { "action": "edit", "resource": "*credentials*", "effect": "deny" }
  ],
  "mcp": {
    "servers": {
      "research": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "git+https://github.com/sydasif/web-search-mcp.git",
          "web-search-mcp"
        ],
        "environment": {
          "EXA_API_KEY": "{env:EXA_API_KEY}",
          "AUTH_TOKEN": "{env:AUTH_TOKEN}",
          "CT0": "{env:CT0}"
        }
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false,
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        }
      },
      "repomix": {
        "type": "local",
        "command": ["npx", "-y", "repomix@latest", "--mcp"]
      }
    }
  },
  "lsp": {
    "pyright": {
      "command": ["pyright-langserver", "--stdio"]
    },
    "ruff": {
      "command": ["ruff", "server"],
      "extensions": [".py", ".pyi"]
    },
    "yaml-ls": { "command": ["npx", "-y", "yaml-language-server", "--stdio"] },
    "bash": { "command": ["npx", "-y", "bash-language-server", "start"] },
    "typescript": { "command": ["typescript-language-server", "--stdio"] }
  },
  "compaction": {
    "auto": true,
    "buffer": 10000
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      ".venv/**",
      "__pycache__/**"
    ]
  }
}

{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["~/.claude/docs/index.md"],
  "default_agent": "plan",
  "formatter": {
    "prettier": {
      "command": ["npx", "prettier", "--write", "$FILE"],
      "extensions": [".ts", ".js", ".json", ".md", ".yaml", ".yml", ".html"]
    },
    "uv": {
      "command": ["uv", "run", "ruff", "format", "$FILE"],
      "extensions": [".py", ".pyi"]
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.secret": "deny",
      "*credentials*": "deny"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.secret": "deny",
      "*credentials*": "deny"
    }
  },
  "mcp": {
    "ddg_search": {
      "type": "local",
      "command": ["web-search-mcp"],
      "enabled": true
    },
    "nornir": {
      "type": "local",
      "command": ["nornir-mcp"],
      "enabled": true,
      "timeout": 30000
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    },
    "repomix": {
      "type": "local",
      "command": ["npx", "-y", "repomix@latest", "--mcp"],
      "enabled": true
    }
  },
  "lsp": {
    "pyright": {
      "command": ["pyright-langserver", "--stdio"]
    },
    "ruff": {
      "command": ["ruff", "server"],
      "extensions": [".py", ".pyi"],
      "initialization": {
        "settings": {
          "exclude": ["*"]
        }
      }
    },
    "yaml-ls": { "command": ["npx", "-y", "yaml-language-server", "--stdio"] },
    "bash": { "command": ["npx", "-y", "bash-language-server", "start"] },
    "typescript": { "command": ["typescript-language-server", "--stdio"] }
  },
  "provider": {
    "bifrost": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Litellm",
      "options": { "baseURL": "http://localhost:4000" },
      "models": {
        "gemma-4-31b-it": { "name": "Gemma-4-31b" },
        "gemma-4-26b-a4b-it": { "name": "Gemma-4-26b" },
        "gemini-3.1-flash-lite": { "name": "Gemini-3.1-flash" }
      }
    }
  }
}

{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "model": "opencode/big-pickle",
  "references": {
    "docs": {
      "path": "~/.config/opencode/docs",
      "description": "Python, uv, Docker, and testing standards. Consult when applying project conventions, packaging, or test strategy."
    }
  },
  "formatter": {
    "prettier": {
      "command": ["npx", "-y", "prettier", "--write", "$FILE"],
      "extensions": [".ts", ".js", ".json", ".md", ".yaml", ".yml", ".html"]
    },
    "uv": {
      "command": ["uv", "run", "ruff", "format", "$FILE"],
      "extensions": [".py", ".pyi"]
    }
  },
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": "*.secret", "effect": "deny" },
    { "action": "read", "resource": "*credentials*", "effect": "deny" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.pem", "effect": "deny" },
    { "action": "edit", "resource": "*.key", "effect": "deny" },
    { "action": "edit", "resource": "*.secret", "effect": "deny" },
    { "action": "edit", "resource": "*credentials*", "effect": "deny" },
    { "action": "shell", "resource": "*git push*", "effect": "ask" },
    { "action": "shell", "resource": "*.env*", "effect": "ask" },
    { "action": "shell", "resource": "*.pem*", "effect": "ask" },
    { "action": "shell", "resource": "*.key*", "effect": "ask" },
    { "action": "shell", "resource": "*.secret*", "effect": "ask" },
    { "action": "shell", "resource": "*credentials*", "effect": "ask" }
  ],
  "mcp": {
    "servers": {
      "research": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "git+https://github.com/sydasif/web-search-mcp.git",
          "web-search-mcp"
        ],
        "environment": {
          "EXA_API_KEY": "{env:EXA_API_KEY}",
          "AUTH_TOKEN": "{env:AUTH_TOKEN}",
          "CT0": "{env:CT0}"
        }
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false,
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        }
      },
      "repomix": {
        "type": "local",
        "command": ["npx", "-y", "repomix@latest", "--mcp"]
      }
    }
  },
  "compaction": {
    "auto": true,
    "buffer": 10000
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      ".venv/**",
      "__pycache__/**"
    ]
  }
}

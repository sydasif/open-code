{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "agnes": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Agnes",
      "options": {
        "baseURL": "https://apihub.agnes-ai.com/v1"
      },
      "models": {
        "agnes-2.0-flash": {
          "name": "Agnes 2.0 Flash"
        }
      }
    }
  },
  "instructions": ["~/.config/opencode/docs/index.md"],
  "default_agent": "plan",
  "formatter": {
    "prettier": {
      "command": ["npx", "prettier", "--write", "$FILE"],
      "extensions": [".ts", ".js", ".json", ".md", ".yaml", ".yml", ".html"]
    },
    "uv": {
      "command": ["uv", "run", "ruff", "format", "$FILE"],
      "extensions": [".py", ".pyi"]
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.secret": "deny",
      "*credentials*": "deny"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.secret": "deny",
      "*credentials*": "deny"
    }
  },
  "mcp": {
    "research": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/sydasif/web-search-mcp.git",
        "web-search-mcp"
      ],
      "environment": {
        "EXA_API_KEY": "{env:EXA_API_KEY}",
        "AUTH_TOKEN": "{env:AUTH_TOKEN}",
        "CT0": "{env:CT0}"
      },
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "repomix": {
      "type": "local",
      "command": ["npx", "-y", "repomix@latest", "--mcp"],
      "enabled": true
    }
  },
  "lsp": {
    "pyright": {
      "command": ["pyright-langserver", "--stdio"]
    },
    "ruff": {
      "command": ["ruff", "server"],
      "extensions": [".py", ".pyi"]
    },
    "yaml-ls": { "command": ["npx", "-y", "yaml-language-server", "--stdio"] },
    "bash": { "command": ["npx", "-y", "bash-language-server", "start"] },
    "typescript": { "command": ["typescript-language-server", "--stdio"] }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      ".venv/**",
      "__pycache__/**"
    ]
  }
}

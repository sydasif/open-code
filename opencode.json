{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["~/.claude/docs/index.md"],
  "default_agent": "plan",
  "formatter": {
    "prettier": {
      "command": ["npx", "prettier", "--write", "$FILE"],
      "extensions": [".ts", ".js", ".json", ".md", ".yaml", ".yml", ".html"]
    },
    "uv": {
      "command": ["uv", "run", "ruff", "format", "$FILE"],
      "extensions": [".py", ".pyi"]
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.secret": "deny",
      "*credentials*": "deny"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.secret": "deny",
      "*credentials*": "deny"
    }
  },
  "mcp": {
    "ddg_search": {
      "type": "local",
      "command": ["web-search-mcp"],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    },
    "repomix": {
      "type": "local",
      "command": ["npx", "-y", "repomix@latest", "--mcp"],
      "enabled": true
    }
  },
  "lsp": {
    "pyright": {
      "command": ["pyright-langserver", "--stdio"]
    },
    "ruff": {
      "command": ["ruff", "server"],
      "extensions": [".py", ".pyi"]
    },
    "yaml-ls": { "command": ["npx", "-y", "yaml-language-server", "--stdio"] },
    "bash": { "command": ["npx", "-y", "bash-language-server", "start"] },
    "typescript": { "command": ["typescript-language-server", "--stdio"] }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      ".venv/**",
      "__pycache__/**"
    ]
  }
}
